<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The Blish HUD module: the one piece of this solution that runs inside Blish HUD, and so
        the one piece on .NET Framework. Blish HUD is net472 and loads modules into its own
        process, which is the whole reason this is a separate, small project rather than part of
        the bridge — see ModuleWire.cs for what it does and ROADMAP.md for why it exists.

        PackBlishModule, below, zips the output into GuildWarsCompanion.Blish.bhm after every
        build. The bridge copies that file next to itself and hands it to Blish HUD with its module
        switch when it starts it, so nothing is installed into Blish HUD's own folders.
    -->
    <PropertyGroup>
        <TargetFramework>net48</TargetFramework>
        <LangVersion>latest</LangVersion>
        <Nullable>enable</Nullable>
        <RootNamespace>GuildWarsCompanion.Blish</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Compile-time only. Blish HUD supplies itself and its dependencies at runtime, and a
             module that shipped its own copy of them would be loading a second Blish HUD.
             Its build targets are left out too: they zip manifest.json exactly as written, and
             the version in it has to come from git — see PackBlishModule. -->
        <PackageReference Include="BlishHUD" Version="1.3.0" ExcludeAssets="runtime;contentFiles;analyzers;build" />
        <PackageReference Include="System.ComponentModel.Composition" Version="6.0.0" />
    </ItemGroup>

    <!-- The wire, compiled from the bridge's copy so the two ends cannot drift apart. -->
    <ItemGroup>
        <Compile Include="..\GuildWarsCompanion.Bridge\Protocol\ModuleWire.cs" Link="ModuleWire.cs" />
        <Compile Include="..\GuildWarsCompanion.Bridge\Protocol\GuideWire.cs" Link="GuideWire.cs" />
        <Compile Include="..\GuildWarsCompanion.Bridge\Protocol\TrailAhead.cs" Link="TrailAhead.cs" />
    </ItemGroup>

    <!--
        What the BlishHUD package's own targets did — zip the output with manifest.json beside it —
        except that the manifest's "version" is replaced by the repository version on the way in
        (Directory.Build.targets), so Blish HUD's module list says which build it loaded. The copy
        in this folder keeps 0.0.0 as a placeholder; it is never shipped as written.

        Blish HUD reads that field as a plain semantic version, so it gets 1.0.42 and not the
        +commit part, which lives in the assembly's informational version instead.

        Escape() because the description contains a semicolon, which WriteLinesToFile would
        otherwise take as the end of one line and the start of the next.
    -->
    <Target Name="PackBlishModule" AfterTargets="Build" DependsOnTargets="CompanionVersion">
        <PropertyGroup>
            <_BhmStaging>$(IntermediateOutputPath)bhm\</_BhmStaging>
            <_BhmFile>$(OutDir)$(ProjectName).bhm</_BhmFile>
            <_BhmPlaceholder>"version": "0.0.0"</_BhmPlaceholder>
            <_BhmManifest>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\manifest.json'))</_BhmManifest>
        </PropertyGroup>

        <Error Condition="!$(_BhmManifest.Contains('$(_BhmPlaceholder)'))"
               Text="manifest.json has no $(_BhmPlaceholder) for the build to replace with the real version." />

        <PropertyGroup>
            <_BhmManifest>$(_BhmManifest.Replace('$(_BhmPlaceholder)', '"version": "$(CompanionVersion)"'))</_BhmManifest>
        </PropertyGroup>

        <ItemGroup>
            <_BhmFiles Include="$(OutDir)**" Exclude="$(OutDir)*.bhm;$(OutDir)manifest.json" />
        </ItemGroup>

        <RemoveDir Directories="$(_BhmStaging)" />
        <Copy SourceFiles="@(_BhmFiles)" DestinationFolder="$(_BhmStaging)%(RecursiveDir)" />
        <WriteLinesToFile File="$(_BhmStaging)manifest.json" Lines="$([MSBuild]::Escape($(_BhmManifest)))"
                          Overwrite="true" />
        <ZipDirectory SourceDirectory="$(_BhmStaging)" DestinationFile="$(_BhmFile)" Overwrite="true" />
        <RemoveDir Directories="$(_BhmStaging)" />
    </Target>

    <Target Name="CleanBlishModule" AfterTargets="Clean">
        <Delete Files="$(OutDir)$(ProjectName).bhm" />
    </Target>

</Project>
