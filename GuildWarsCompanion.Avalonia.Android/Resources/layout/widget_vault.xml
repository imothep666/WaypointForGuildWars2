<?xml version="1.0" encoding="utf-8"?>
<!--
    The Wizard's Vault widget. Two clocks and one call to action.

    "N to claim" is the only line that ever turns brass, because it is the only one that is
    losing you something: an unclaimed daily reward is gone at reset. Progress is just progress.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:id="@+id/vault_root"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:background="@drawable/widget_frame"
             android:clipToOutline="true">

    <!-- The area's painted wash, as the app's masthead has it. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:src="@drawable/widget_wash_vault" />

<LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:paddingStart="16dp"
              android:paddingEnd="14dp"
              android:paddingTop="12dp"
              android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- At its own size, never stretched: the bitmap carries the screen's density, so its
             natural size is the heading's 16sp. Wider than the widget, it is scaled down. -->
        <ImageView
            android:id="@+id/vault_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <!-- Only shown when something is actually waiting. -->
        <TextView
            android:id="@+id/vault_claim"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textColor="@color/widgetBrass"
            android:textSize="12sp"
            android:maxLines="1" />
    </LinearLayout>


    <!-- A dry-brush stroke of the area's tint under the heading, as on every page. -->
    <ImageView
        android:layout_width="110dp"
        android:layout_height="7dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="1dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_stroke"
        android:tint="@color/widgetAstral" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="7dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DAILY"
                android:textColor="@color/widgetMist"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/vault_daily"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widgetVellum"
                android:textSize="19sp"
                android:maxLines="1" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WEEKLY"
                android:textColor="@color/widgetMist"
                android:textSize="10sp"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/vault_weekly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/widgetVellum"
                android:textSize="19sp"
                android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>

    <!-- Weighted, so a widget given less height than it asked for loses the reset clock rather
         than the two figures. See widget_bosses.xml. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- A FrameLayout for the rule, for the reason widget_bosses.xml gives. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="7dp"
            android:background="@color/widgetBrassDim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/vault_reset"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widgetMist"
            android:textSize="12sp"
            android:maxLines="1" />

        <!-- How old the figures are, said only once that is worth saying. -->
        <TextView
            android:id="@+id/vault_age"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widgetMist"
            android:textSize="11sp"
            android:maxLines="1" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
</FrameLayout>
