<?xml version="1.0" encoding="utf-8"?>
<!--
    The world boss widget.

    Only the views a launcher will inflate: RemoteViews accepts FrameLayout, LinearLayout,
    TextView, ImageView, ProgressBar, Chronometer and little else. The heading is an image the
    app paints in its own Marcellus SC (WidgetDraw.Carved): a launcher may ignore a font
    resource on a TextView, and the phone's own launcher did. The ember of the timetable,
    which is where these bosses live in the app.

    The countdown is a Chronometer rather than a string the app keeps rewriting: Android ticks
    it in the launcher's own process, so the seconds stay live while this app stays asleep.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
             android:id="@+id/boss_root"
             android:layout_width="match_parent"
             android:layout_height="match_parent"
             android:background="@drawable/widget_frame"
             android:clipToOutline="true">

    <!-- The area's painted wash, as the app's masthead has it. -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.45"
        android:src="@drawable/widget_wash_bosses" />

<LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:paddingStart="16dp"
              android:paddingEnd="14dp"
              android:paddingTop="12dp"
              android:paddingBottom="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- At its own size, never stretched: the bitmap carries the screen's density, so its
             natural size is the heading's 16sp. Wider than the widget, it is scaled down. -->
        <ImageView
            android:id="@+id/boss_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitStart" />

        <TextView
            android:id="@+id/boss_footnote"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:gravity="end"
            android:ellipsize="end"
            android:textColor="@color/widgetMist"
            android:textSize="10sp"
            android:maxLines="1" />
    </LinearLayout>


    <!-- A dry-brush stroke of the area's tint under the heading, as on every page. -->
    <ImageView
        android:layout_width="110dp"
        android:layout_height="7dp"
        android:layout_marginStart="-4dp"
        android:layout_marginTop="1dp"
        android:scaleType="fitXY"
        android:src="@drawable/widget_stroke"
        android:tint="@color/widgetEmber" />

    <!-- The one the widget exists for: what is next, where, and how long you have. -->
    <TextView
        android:id="@+id/boss_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/widgetVellum"
        android:textSize="17sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/boss_where"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/widgetMist"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

        <Chronometer
            android:id="@+id/boss_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/widgetBrass"
            android:textSize="15sp" />
    </LinearLayout>

    <!--
        Weighted, so it is the part that gives way. A launcher can hand a 4x2 widget far less
        height than it asked for — a landscape home screen does exactly that — and a plain
        LinearLayout answers by clipping its last children, which here would cut the countdown
        in half while the two lines below it kept their space. At zero height this block simply
        disappears and the boss, the place and the clock survive.
    -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--
            A FrameLayout and not a View, which looks like the obvious choice and is not:
            RemoteViews inflates only a fixed whitelist of classes, plain View is not on it, and
            a layout holding one is refused whole with "Widget could not be added". This is the
            app's hairline rule.
        -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="9dp"
            android:layout_marginBottom="7dp"
            android:background="@color/widgetBrassDim" />

    <TextView
        android:id="@+id/boss_later_one"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/widgetMist"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/boss_later_two"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="@color/widgetMist"
        android:textSize="12sp"
        android:maxLines="1"
        android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
</FrameLayout>
