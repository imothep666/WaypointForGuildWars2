<?xml version="1.0" encoding="utf-8"?>
<!--
  Sideload build: a single signed .apk to copy onto a phone and install directly.

  Not a Play Store build: Google Play takes .aab. Signed with the app's own key, which the
  project file sets up; see SideloadApk.md next to this file.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Android</_TargetId>

    <Configuration>Release</Configuration>
    <TargetFramework>net10.0-android</TargetFramework>

    <!-- Every Android 15 phone is 64-bit ARM. Add android-x64 to the list if you also want
         the package to install on an emulator; it roughly doubles the download. -->
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>

    <!-- .aab is the default for Release. This is what makes it an installable file. -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <PublishTrimmed>true</PublishTrimmed>
    <AndroidLinkMode>SdkOnly</AndroidLinkMode>
  </PropertyGroup>
</Project>
