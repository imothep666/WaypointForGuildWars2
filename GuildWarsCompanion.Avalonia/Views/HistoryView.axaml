<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:controls="using:GuildWarsCompanion.Ava.Controls"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.HistoryView"
                x:DataType="vm:HistoryViewModel"
                ShowsWash="True">

    <!-- The masthead and the tabs stay where they are; only the trades below them scroll. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Both sides of the ledger, as the materials screen sets its two values side by side:
             what the recent sales and purchases came to. -->
        <Border Classes="masthead">
            <Grid VerticalAlignment="Bottom" ColumnDefinitions="*,14,*">
                    <StackPanel Spacing="2" IsVisible="{Binding Sold, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Sold.Title}" Classes="caption" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding Sold.Coin.Gold}" FontFamily="{StaticResource BarlowSemiBold}"
                                           FontSize="34" Foreground="{StaticResource MetalGoldBrush}" />
                                <TextBlock Text="g" FontSize="15" Foreground="{StaticResource MetalGoldBrush}"
                                           VerticalAlignment="Bottom" Margin="-7,0,0,7" />
                                <TextBlock Text="{Binding Sold.Coin.Silver}" FontFamily="{StaticResource BarlowSemiBold}"
                                           FontSize="34" Foreground="{StaticResource MetalSilverBrush}" />
                                <TextBlock Text="s" FontSize="15" Foreground="{StaticResource MetalSilverBrush}"
                                           VerticalAlignment="Bottom" Margin="-7,0,0,7" />
                                <TextBlock Text="{Binding Sold.Coin.Copper}" FontFamily="{StaticResource BarlowSemiBold}"
                                           FontSize="34" Foreground="{StaticResource MetalCopperBrush}" />
                                <TextBlock Text="c" FontSize="15" Foreground="{StaticResource MetalCopperBrush}"
                                           VerticalAlignment="Bottom" Margin="-7,0,0,7" />
                            </StackPanel>
                        </Viewbox>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Spacing="2" IsVisible="{Binding Bought, Converter={x:Static ObjectConverters.IsNotNull}}">
                        <TextBlock Text="{Binding Bought.Title}" Classes="caption" />
                        <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                                <TextBlock Text="{Binding Bought.Coin.Gold}" FontFamily="{StaticResource BarlowSemiBold}"
                                           FontSize="34" Foreground="{StaticResource MetalGoldBrush}" />
                                <TextBlock Text="g" FontSize="15" Foreground="{StaticResource MetalGoldBrush}"
                                           VerticalAlignment="Bottom" Margin="-7,0,0,7" />
                                <TextBlock Text="{Binding Bought.Coin.Silver}" FontFamily="{StaticResource BarlowSemiBold}"
                                           FontSize="34" Foreground="{StaticResource MetalSilverBrush}" />
                                <TextBlock Text="s" FontSize="15" Foreground="{StaticResource MetalSilverBrush}"
                                           VerticalAlignment="Bottom" Margin="-7,0,0,7" />
                                <TextBlock Text="{Binding Bought.Coin.Copper}" FontFamily="{StaticResource BarlowSemiBold}"
                                           FontSize="34" Foreground="{StaticResource MetalCopperBrush}" />
                                <TextBlock Text="c" FontSize="15" Foreground="{StaticResource MetalCopperBrush}"
                                           VerticalAlignment="Bottom" Margin="-7,0,0,7" />
                            </StackPanel>
                        </Viewbox>
                    </StackPanel>
            </Grid>
        </Border>

        <controls:AreaTabStrip Grid.Row="1" Area="tradingpost" Current="history" />

        <StackPanel Grid.Row="2" Margin="20,0" Spacing="8">
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error"
                       Margin="0,12,0,0" />
        </StackPanel>

        <RefreshContainer Grid.Row="3" RefreshRequested="OnPullRefresh">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                               IsVisible="{Binding Sections.Count, Converter={x:Static ui:Counts.IsZero}}"
                               HorizontalAlignment="Center" Margin="0,32" />

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:OrderSection">
                                <StackPanel>
                                    <controls:SectionBand Title="{Binding Title}" Summary="{Binding Summary}" />

                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:OrderRow">
                                                <Grid ColumnDefinitions="4,40,*,Auto" RowDefinitions="Auto,*"
                                                      Margin="20,0" MinHeight="62">
                                                    <Border Grid.RowSpan="2"
                                                            Background="{Binding RarityColor, Converter={x:Static ui:Paint.Brush}}" />
                                                    <Image Grid.RowSpan="2" Grid.Column="1"
                                                           ui:WebImage.Url="{Binding IconUrl}" Width="28" Height="28"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ItemName}"
                                                               Margin="14,12,8,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Total}" Classes="figure"
                                                               Margin="0,12,0,0" HorizontalAlignment="Right" />
                                                    <!-- The market line: brass when the market has moved past you. -->
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MarketNote}"
                                                               Classes="caption" TextWrapping="NoWrap"
                                                               Foreground="{Binding NoteColor, Converter={x:Static ui:Paint.Brush}}"
                                                               Margin="14,2,8,12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding UnitPrice}"
                                                               Classes="caption" Margin="0,2,0,12"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</shell:PageView>
