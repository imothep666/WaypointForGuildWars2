<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.MapPickerView"
                x:DataType="vm:MapPickerViewModel">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="20,12,20,0" Spacing="8">
            <!--
                The whole term is selected when the box gets focus, so the first keystroke
                replaces it.

                The text is kept between visits on purpose — coming back to refine "gorge" beats
                retyping it — but it then sits there as a filter somebody has forgotten about, and
                typing appends to it: "snowden" typed into a box still holding "gorge" searched
                for "gorgesnowden" and answered, correctly and uselessly, that no map is called
                that.
            -->
            <TextBox x:Name="Search" Text="{Binding Search}" PlaceholderText="{ui:T 'Map name'}"
                     GotFocus="OnSearchFocused" />

            <TextBlock Text="{Binding ResultNote}" Classes="caption small" />
            <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="caption" />
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" />
        </StackPanel>

        <!-- Virtualised: this list is long by nature, and the whole point of the screen is that
             it is scrolled and typed at. -->
        <Grid Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                       IsVisible="{Binding Results.Count, Converter={x:Static ui:Counts.IsZero}}"
                       HorizontalAlignment="Center" Margin="0,32" />

            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:MapChoice">
                        <Button Classes="row" Click="OnRowClicked">
                            <Grid ColumnDefinitions="4,*" RowDefinitions="Auto,Auto" Margin="20,0"
                                  MinHeight="62">
                                <Border Grid.RowSpan="2" Background="{StaticResource BrassBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="16,12,10,0"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- "Shiverpeak Mountains · Tyria". A map name alone is ambiguous
                                     often enough — there are two Lion's Arches and a dozen guild halls. -->
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Where}"
                                           Classes="caption" Margin="16,2,10,12" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Grid>
</shell:PageView>
