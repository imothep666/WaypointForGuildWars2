<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:controls="using:GuildWarsCompanion.Ava.Controls"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.DeliveryView"
                x:DataType="vm:DeliveryViewModel"
                ShowsWash="True">

    <Grid RowDefinitions="Auto,Auto,*">
        <controls:AreaTabStrip Area="tradingpost" Current="delivery" />

        <StackPanel Grid.Row="1" Margin="20,14,20,0" Spacing="12">
            <!-- Coins from completed sales, in the same three metals as the wallet. -->
            <Border Classes="card" IsVisible="{Binding HasCoins}">
                <StackPanel Spacing="8">
                    <TextBlock Text="READY TO COLLECT" Classes="heading small" />
                    <!-- The metals in their own colours. -->
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="{Binding Coins.Gold}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="28" Foreground="{StaticResource MetalGoldBrush}" />
                        <TextBlock Text="g" FontSize="14" Foreground="{StaticResource MetalGoldBrush}" VerticalAlignment="Bottom"
                                   Margin="-7,0,0,5" />
                        <TextBlock Text="{Binding Coins.Silver}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="28" Foreground="{StaticResource MetalSilverBrush}" />
                        <TextBlock Text="s" FontSize="14" Foreground="{StaticResource MetalSilverBrush}" VerticalAlignment="Bottom"
                                   Margin="-7,0,0,5" />
                        <TextBlock Text="{Binding Coins.Copper}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="28" Foreground="{StaticResource MetalCopperBrush}" />
                        <TextBlock Text="c" FontSize="14" Foreground="{StaticResource MetalCopperBrush}" VerticalAlignment="Bottom"
                                   Margin="-7,0,0,5" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" />
        </StackPanel>

        <RefreshContainer Grid.Row="2" Margin="0,10,0,0" RefreshRequested="OnPullRefresh">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                               IsVisible="{Binding Items.Count, Converter={x:Static ui:Counts.IsZero}}"
                               HorizontalAlignment="Center" Margin="0,32" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:OrderRow">
                                <Grid ColumnDefinitions="4,40,*,Auto" Margin="20,0" MinHeight="52">
                                    <Border Background="{Binding RarityColor, Converter={x:Static ui:Paint.Brush}}" />
                                    <Image Grid.Column="1" ui:WebImage.Url="{Binding IconUrl}" Width="28"
                                           Height="28" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding ItemName}" Margin="14,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Quantity}" Classes="figure"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</shell:PageView>
