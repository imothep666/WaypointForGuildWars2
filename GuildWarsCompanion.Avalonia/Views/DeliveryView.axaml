<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:controls="using:GuildWarsCompanion.Ava.Controls"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.DeliveryView"
                x:DataType="vm:DeliveryViewModel"
                ShowsWash="True">

    <!-- The masthead and the tabs stay where they are; only the items below them scroll. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- Coins from completed sales, in the same three metals as the wallet, where the wallet
             has its coin. -->
        <Border Classes="masthead">
            <StackPanel VerticalAlignment="Bottom" Spacing="4" IsVisible="{Binding HasCoins}">
                <TextBlock Text="{ui:T 'READY TO COLLECT'}" Classes="heading small" />
                <Viewbox StretchDirection="DownOnly" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <TextBlock Text="{Binding Coins.Gold}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="54" Foreground="{StaticResource MetalGoldBrush}" />
                        <TextBlock Text="g" FontSize="18" Foreground="{StaticResource MetalGoldBrush}"
                                   VerticalAlignment="Bottom" Margin="-9,0,0,11" />
                        <TextBlock Text="{Binding Coins.Silver}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="54" Foreground="{StaticResource MetalSilverBrush}" />
                        <TextBlock Text="s" FontSize="18" Foreground="{StaticResource MetalSilverBrush}"
                                   VerticalAlignment="Bottom" Margin="-9,0,0,11" />
                        <TextBlock Text="{Binding Coins.Copper}" FontFamily="{StaticResource BarlowSemiBold}"
                                   FontSize="54" Foreground="{StaticResource MetalCopperBrush}" />
                        <TextBlock Text="c" FontSize="18" Foreground="{StaticResource MetalCopperBrush}"
                                   VerticalAlignment="Bottom" Margin="-9,0,0,11" />
                    </StackPanel>
                </Viewbox>
            </StackPanel>
        </Border>

        <controls:AreaTabStrip Grid.Row="1" Area="tradingpost" Current="delivery" />

        <StackPanel Grid.Row="2" Margin="20,0" Spacing="12">
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error"
                       Margin="0,12,0,0" />
        </StackPanel>

        <RefreshContainer Grid.Row="3" Margin="0,10,0,0" RefreshRequested="OnPullRefresh">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                               IsVisible="{Binding Items.Count, Converter={x:Static ui:Counts.IsZero}}"
                               HorizontalAlignment="Center" Margin="0,32" />

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:OrderRow">
                                <Grid ColumnDefinitions="4,40,*,Auto" Margin="20,0" MinHeight="52">
                                    <Border Background="{Binding RarityColor, Converter={x:Static ui:Paint.Brush}}" />
                                    <Image Grid.Column="1" ui:WebImage.Url="{Binding IconUrl}" Width="28"
                                           Height="28" VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding ItemName}" Margin="14,0,8,0"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding Quantity}" Classes="figure"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</shell:PageView>
