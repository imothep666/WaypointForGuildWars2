<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.FestivalsView"
                x:DataType="vm:FestivalsViewModel">

    <ScrollViewer>
        <StackPanel Margin="20,16,20,32" Spacing="14">
            <TextBlock Text="{ui:T 'THE YEAR\'S FESTIVALS'}" Classes="heading" />

            <!-- Brass for the festival on now, quiet for the rest, as on Today. -->
            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="services:FestivalEntry">
                        <Grid ColumnDefinitions="4,*,Auto" RowDefinitions="Auto,Auto" MinHeight="60" Margin="0,0,0,10">
                            <Border Grid.RowSpan="2" Background="{StaticResource BrassBrush}" IsVisible="{Binding IsOn}" />
                            <Border Grid.RowSpan="2" Background="{StaticResource BankedBrush}" IsVisible="{Binding !IsOn}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="16,8,10,0"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="2" Text="{Binding Note}" Classes="caption small"
                                       Margin="0,10,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding When}"
                                       Classes="caption" TextWrapping="Wrap" Margin="16,3,0,8" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Where the dates come from, and why most of them are seasons. -->
            <TextBlock Text="{ui:T 'Dates come from the Guild Wars 2 Wiki once ArenaNet has announced them, usually a week or two ahead. Until then a festival shows when it ran in past years.'}"
                       Classes="caption small" TextWrapping="Wrap" Margin="0,6,0,0" />
        </StackPanel>
    </ScrollViewer>
</shell:PageView>
