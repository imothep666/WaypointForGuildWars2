<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:controls="using:GuildWarsCompanion.Ava.Controls"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.OrdersView"
                x:DataType="vm:OrdersViewModel"
                ShowsWash="True">

    <!-- The masthead and the tabs stay where they are; only the orders below them scroll. -->
    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <!-- What needs doing: orders the market has moved past. Which ones, and by how much, is
             in brass in the list below. -->
        <Border Classes="masthead">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Bottom"
                        IsVisible="{Binding Beaten, Converter={x:Static ObjectConverters.IsNotNull}}">
                <TextBlock Text="{Binding Beaten}" FontFamily="{StaticResource BarlowSemiBold}" FontSize="54" />
                <TextBlock Text="{Binding BeatenLabel}" Foreground="{DynamicResource AreaTintBrush}"
                           VerticalAlignment="Bottom" Margin="0,0,0,10" />
            </StackPanel>
        </Border>

        <controls:AreaTabStrip Grid.Row="1" Area="tradingpost" Current="orders" />

        <StackPanel Grid.Row="2" Margin="20,0" Spacing="8">
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error"
                       Margin="0,12,0,0" />
            <TextBlock Text="{Binding Linked}" IsVisible="{Binding HasLinked}" Classes="caption"
                       TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>

        <RefreshContainer Grid.Row="3" RefreshRequested="OnPullRefresh">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                               IsVisible="{Binding Sections.Count, Converter={x:Static ui:Counts.IsZero}}"
                               HorizontalAlignment="Center" Margin="0,32" />

                    <ItemsControl ItemsSource="{Binding Sections}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:OrderSection">
                                <StackPanel>
                                    <controls:SectionBand Title="{Binding Title}" Summary="{Binding Summary}" />

                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:OrderRow">
                                                <Grid ColumnDefinitions="4,40,*,Auto" RowDefinitions="Auto,*,Auto"
                                                      Margin="20,0" MinHeight="62">
                                                    <Border Grid.RowSpan="3"
                                                            Background="{Binding RarityColor, Converter={x:Static ui:Paint.Brush}}" />
                                                    <Image Grid.RowSpan="2" Grid.Column="1"
                                                           ui:WebImage.Url="{Binding IconUrl}" Width="28" Height="28"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ItemName}"
                                                               Margin="14,12,8,0" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Total}" Classes="figure"
                                                               Margin="0,12,0,0" HorizontalAlignment="Right" />
                                                    <!-- The market line: brass when the market has moved past you. -->
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MarketNote}"
                                                               Classes="caption" TextWrapping="NoWrap"
                                                               Foreground="{Binding NoteColor, Converter={x:Static ui:Paint.Brush}}"
                                                               Margin="14,2,8,12" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding UnitPrice}"
                                                               Classes="caption" Margin="0,2,0,12"
                                                               HorizontalAlignment="Right" />
                                                    <!-- Only where the market has moved past: relisting starts
                                                         with the item in the trading post's search. Pulled up
                                                         into the market line's bottom margin, which otherwise
                                                         left a gap above it. -->
                                                    <Button Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2"
                                                            Content="{ui:T 'SEND TO TP'}" IsVisible="{Binding IsBeaten}"
                                                            Classes="quiet" FontSize="11" Padding="10,3" Margin="0,-8,0,12"
                                                            HorizontalAlignment="Right" Click="OnSendClicked" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</shell:PageView>
