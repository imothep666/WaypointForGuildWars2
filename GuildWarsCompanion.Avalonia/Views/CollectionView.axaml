<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.CollectionView"
                x:DataType="vm:CollectionViewModel"
                PageTitle="{Binding Title}">

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="20,14,20,0" Spacing="6">
            <!-- What the collection is for, and how far along it is. -->
            <TextBlock Text="{Binding Requirement}" Classes="caption" />
            <TextBlock Text="{Binding Summary}" Classes="figure" Foreground="{StaticResource BrassBrush}" />
            <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="caption"
                       Margin="0,6,0,0" />
            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" />
        </StackPanel>

        <RefreshContainer Grid.Row="1" Margin="0,10,0,0" RefreshRequested="OnPullRefresh">
            <ScrollViewer>
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                               IsVisible="{Binding Rows.Count, Converter={x:Static ui:Counts.IsZero}}"
                               HorizontalAlignment="Center" Margin="0,32" />

                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:CollectionRow">
                                <Button Classes="row" Click="OnRowClicked">
                                    <Grid ColumnDefinitions="4,Auto,*,Auto" RowDefinitions="Auto,*"
                                          Margin="20,0" MinHeight="56">
                                        <!-- Brass while it is still something to go and get. -->
                                        <Border Grid.RowSpan="2"
                                                Background="{Binding EdgeColor, Converter={x:Static ui:Paint.Brush}}" />
                                        <!-- Map steps have no picture; the column collapses. -->
                                        <Image Grid.RowSpan="2" Grid.Column="1"
                                               ui:WebImage.Url="{Binding IconUrl}"
                                               IsVisible="{Binding HasIcon}" Width="28" Height="28"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="16,13,10,13"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="3" Text="{Binding StatusText}"
                                                   Classes="caption small" Margin="0,11,0,0" />
                                        <!-- Only worth a line where the collection mixes kinds. -->
                                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                   Text="{Binding KindText}" IsVisible="{Binding ShowKind}"
                                                   Classes="caption small" Margin="16,2,0,11" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="{Binding Footnote}" Classes="caption small"
                               Margin="24,14,20,24" />
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</shell:PageView>
