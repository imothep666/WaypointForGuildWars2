<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                x:Class="GuildWarsCompanion.Ava.Views.CraftingView"
                x:DataType="vm:CraftingViewModel">

    <RefreshContainer RefreshRequested="OnPullRefresh">
        <ScrollViewer>
            <StackPanel Margin="20,16,20,32" Spacing="14">
                <TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="caption" />
                <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" />

                <!-- Where each discipline stands. Tap one to move the advice to it. -->
                <TextBlock Text="{ui:T 'DISCIPLINES'}" Classes="heading" />

                <ItemsControl ItemsSource="{Binding Disciplines}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:DisciplineRow">
                            <Button Classes="row" Click="OnDisciplineClicked" Margin="0,0,0,8">
                                <Grid ColumnDefinitions="4,*,Auto" RowDefinitions="Auto,Auto,*" MinHeight="66">
                                    <Border Grid.RowSpan="3" Background="{StaticResource BrassDimBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Margin="16,10,8,0" />
                                    <TextBlock Grid.Column="2" Text="{Binding Character}" Classes="caption small"
                                               Margin="0,10,0,0" />
                                    <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                 Minimum="0" Maximum="1" Value="{Binding Fraction}"
                                                 Margin="16,6,0,0" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                               Text="{Binding RatingText}" Classes="caption small"
                                               Margin="16,4,0,10" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Classes="rule" Margin="0,6,0,0" />

                <!-- The advice: what to make next, cheapest first. -->
                <TextBlock Text="{ui:T 'WHAT TO MAKE NEXT'}" Classes="heading small" Margin="0,4,0,0" />
                <TextBlock Text="{Binding SuggestionHeading}" Classes="figure" FontSize="14"
                           Foreground="{StaticResource BrassBrush}" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Suggestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:LevellingRow">
                            <Button Classes="row" Click="OnSuggestionClicked" Margin="0,0,0,6">
                                <Grid ColumnDefinitions="4,*,Auto" RowDefinitions="Auto,*" MinHeight="54">
                                    <Border Grid.RowSpan="2" Background="{StaticResource BrassBrush}" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="16,9,8,0"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="2" Text="{Binding CostText}" Classes="figure"
                                               Margin="0,9,0,0" />
                                    <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                                Orientation="Horizontal" Spacing="10" Margin="16,2,0,9">
                                        <TextBlock Text="{Binding RatingText}" Classes="caption small" />
                                        <TextBlock Text="{Binding HoldingText}" Classes="caption small"
                                                   Foreground="{StaticResource VellumBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- What the list is and is not. -->
                <TextBlock Text="{Binding Note}" Classes="caption small" />

                <!-- The other crafting question, and the one the API answers least: not
                     what to make next, but what can be made right now. Both halves are
                     already on the phone — the recipe catalogue and the storage scan —
                     so this is a join rather than a fetch. -->
                <Border Classes="rule" Margin="0,14,0,0" />
                <TextBlock Text="{ui:T 'FROM WHAT YOU HAVE'}" Classes="heading" Margin="0,6,0,0" />

                <Button Content="{ui:T 'CHECK MY MATERIALS'}" Command="{Binding ReadStorageCommand}"
                        IsVisible="{Binding CanReadStorage}" Classes="quiet" HorizontalAlignment="Left" />

                <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsReadingStorage}" />

                <TextBlock Text="{Binding MakeableSummary}" Classes="figure" FontSize="14"
                           Foreground="{StaticResource BrassBrush}" TextWrapping="Wrap" />

                <ItemsControl ItemsSource="{Binding Makeable}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="services:MakeableItemRow">
                            <Grid ColumnDefinitions="4,38,*" RowDefinitions="Auto,*" MinHeight="52"
                                  Margin="0,0,0,2">
                                <Border Grid.RowSpan="2"
                                        Background="{Binding RarityColor, Converter={x:Static ui:Paint.Brush}}" />
                                <Image Grid.RowSpan="2" Grid.Column="1" ui:WebImage.Url="{Binding IconUrl}"
                                       Width="26" Height="26" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="14,9,8,0"
                                           TextTrimming="CharacterEllipsis" />
                                <!-- Which discipline, on which character, and how many
                                     times over: the recipe cannot be made without them. -->
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Detail}" Classes="caption small"
                                           Margin="14,2,8,9" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding MakeableNote}" IsVisible="{Binding HasMakeable}" Classes="caption small" />
            </StackPanel>
        </ScrollViewer>
    </RefreshContainer>
</shell:PageView>
