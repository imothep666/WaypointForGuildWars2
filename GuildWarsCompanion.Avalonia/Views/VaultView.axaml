<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:services="using:GuildWarsCompanion.Services"
                xmlns:ui="using:GuildWarsCompanion.Ava.Ui"
                xmlns:controls="using:GuildWarsCompanion.Ava.Controls"
                x:Class="GuildWarsCompanion.Ava.Views.VaultView"
                x:DataType="vm:VaultViewModel"
                ShowsWash="True">

    <shell:PageView.Styles>
        <!-- Finished with the reward still in the vault: a warm glow from the spine. -->
        <Style Selector="Grid.ready">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="70%,0%">
                    <GradientStop Offset="0" Color="#21C8A34E" />
                    <GradientStop Offset="1" Color="#00C8A34E" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Grid.ready TextBlock.count">
            <Setter Property="Foreground" Value="{StaticResource BrassBrush}" />
        </Style>
        <!-- Taken: it steps back. -->
        <Style Selector="Grid.claimed">
            <Setter Property="Opacity" Value="0.5" />
        </Style>
    </shell:PageView.Styles>

    <Grid RowDefinitions="Auto,*">
        <StackPanel Margin="20,6,20,0" Spacing="12">
            <!-- Astral Acclaim is what every objective pays out, so it leads the screen, large, on
                 the vault's astral wash. -->
            <StackPanel IsVisible="{Binding HasAcclaim}" Spacing="14" Margin="0,0,0,8">
                <TextBlock Text="{Binding SeasonLine}" Classes="caption" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="{Binding AcclaimText}" FontFamily="{StaticResource BarlowSemiBold}"
                               FontSize="60" />
                    <TextBlock Text="Astral Acclaim" Foreground="{DynamicResource AreaTintBrush}"
                               VerticalAlignment="Bottom" Margin="0,0,0,8" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Classes="error" />

            <controls:PageTabStrip Tabs="{Binding Tabs}" Selected="OnTabSelected" />
        </StackPanel>

        <RefreshContainer Grid.Row="1" Margin="0,12,0,0" RefreshRequested="OnPullRefresh">
            <ScrollViewer x:Name="Scroller">
                <StackPanel>
                    <TextBlock Text="{Binding EmptyMessage}" Classes="caption"
                               IsVisible="{Binding Sections.Count, Converter={x:Static ui:Counts.IsZero}}"
                               HorizontalAlignment="Center" Margin="0,32" />

                    <ItemsControl ItemsSource="{Binding Sections}" IsVisible="{Binding IsObjectives}"
                                  Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="services:VaultSection">
                                <StackPanel>
                                    <!-- The note is set when the objectives belong to a cycle
                                         that has already ended. -->
                                    <controls:SectionBand Title="{Binding Name}" Summary="{Binding Summary}"
                                                          Note="{Binding Warning}" />

                                    <ItemsControl ItemsSource="{Binding}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="services:VaultRow">
                                                <!-- Two lines: the name over its bar, the reward over the
                                                     count. The right-hand column is one width on every row
                                                     of every track, so the bars all end in the same place
                                                     however long the count. Brass on the spine means there
                                                     is something to go and collect. -->
                                                <Grid RowDefinitions="Auto,Auto" Margin="20,0" MinHeight="60"
                                                      Classes.ready="{Binding IsUnclaimed}"
                                                      Classes.claimed="{Binding Claimed}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="4" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" SharedSizeGroup="VaultFigures" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.RowSpan="2"
                                                            Background="{Binding StatusColor, Converter={x:Static ui:Paint.Brush}}" />
                                                    <Grid Grid.Column="1" ColumnDefinitions="Auto,*" Margin="16,12,10,0">
                                                        <!-- A tick on what has been taken. -->
                                                        <Path Data="M1,5 L4,8 L10,1" Stroke="{StaticResource BrassBrush}"
                                                              StrokeThickness="1.6" VerticalAlignment="Center"
                                                              Margin="0,0,8,0" IsVisible="{Binding Claimed}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Title}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </Grid>
                                                    <TextBlock Grid.Column="2" Text="{Binding AcclaimText}" Classes="figure"
                                                               Margin="0,12,0,0" HorizontalAlignment="Right"
                                                               Foreground="{StaticResource BrassBrush}" />
                                                    <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1"
                                                                 Value="{Binding Fraction}" Margin="16,6,12,12"
                                                                 VerticalAlignment="Center" />
                                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding CountText}"
                                                               Classes="caption small count" Margin="0,6,0,12"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The shop: what Acclaim buys, in the game's three places. Brass when it can
                         be bought now. -->
                    <StackPanel IsVisible="{Binding IsShop}">
                        <TextBlock Text="{Binding ShopNote}" IsVisible="{Binding HasShopNote}" Classes="caption"
                                   Foreground="{StaticResource BrassBrush}" TextWrapping="Wrap" Margin="20,0,20,10" />
                        <ItemsControl ItemsSource="{Binding Shop}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="services:VaultShopSection">
                                    <StackPanel>
                                        <controls:SectionBand Title="{Binding Name}" Summary="{Binding Summary}" />
                                        <ItemsControl ItemsSource="{Binding}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="services:VaultShopRow">
                                                    <!-- The trading post's item row, with Acclaim for coin. -->
                                                    <Grid ColumnDefinitions="4,40,*,Auto" RowDefinitions="Auto,*"
                                                          Margin="20,0" MinHeight="62">
                                                        <Border Grid.RowSpan="2"
                                                                Background="{Binding StatusColor, Converter={x:Static ui:Paint.Brush}}" />
                                                        <Image Grid.RowSpan="2" Grid.Column="1" Width="28" Height="28"
                                                               Margin="12,0,0,0" VerticalAlignment="Center"
                                                               ui:WebImage.Url="{Binding Icon}" />
                                                        <!-- A featured reward's banner painting over its icon, a
                                                             size up, once it has arrived from the wiki. -->
                                                        <Image Grid.RowSpan="2" Grid.Column="1" Width="44" Height="44"
                                                               Margin="4,0,-8,0" VerticalAlignment="Center"
                                                               ui:WikiArt.Banner="{Binding BannerName}" />
                                                        <TextBlock Grid.Column="2" Text="{Binding Title}" Margin="14,12,8,0"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="3" Text="{Binding CostText}" Classes="figure"
                                                                   Margin="0,12,0,0" Foreground="{StaticResource BrassBrush}" />
                                                        <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                                   Text="{Binding LimitText}" Classes="caption"
                                                                   Margin="14,2,0,12" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </RefreshContainer>
    </Grid>
</shell:PageView>
