<shell:PageView xmlns="https://github.com/avaloniaui"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                xmlns:shell="using:GuildWarsCompanion.Ava.Shell"
                xmlns:vm="using:GuildWarsCompanion.ViewModels"
                xmlns:controls="using:GuildWarsCompanion.Ava.Controls"
                x:Class="GuildWarsCompanion.Ava.Views.CompassView"
                x:DataType="vm:CompassViewModel"
                ShowsBand="True">

    <Grid>
        <!--
            The dial in the middle, the controls in a rail against the bottom edge — the handset's
            USB edge, so a fixed place in the room. The dial is drawn, and turned inside its own
            drawing; only what sits in the rail turns as views. See PlaceRail.
        -->
        <Grid Margin="8" RowDefinitions="*,Auto" RowSpacing="8">
            <controls:DrawableView x:Name="Rose" />

            <ContentControl x:Name="RailSlot" Grid.Row="1" HorizontalAlignment="Center"
                            VerticalAlignment="Bottom" />
        </Grid>

        <!-- The picker sits over the whole page rather than pushing it about: the compass is the
             screen, and choosing is a moment. A pushed page would stop the bridge stream. -->
        <Grid IsVisible="{Binding IsPickerOpen}" Background="{StaticResource ObsidianBrush}"
              RowDefinitions="Auto,*" Margin="0">

            <!-- The sheet's own header: the back affordance the rest of the app uses, then the
                 tab strip the rest of the app uses. -->
            <Grid ColumnDefinitions="Auto,*" Margin="20,16,20,0">
                <Button Classes="row" Width="34" Click="OnSheetBack" VerticalAlignment="Top">
                    <Path Data="M16,6 H2 M7,1 L2,6 L7,11" Stroke="{StaticResource MistBrush}"
                          StrokeThickness="1.6" HorizontalAlignment="Center" Margin="0,4" />
                </Button>
                <controls:PageTabStrip Grid.Column="1" Margin="18,0,0,0" Tabs="{Binding Tabs}"
                                       Selected="OnSheetTabSelected" />
            </Grid>

            <!-- Clicked rather than a bound command: the handler resolves the row from its own
                 DataContext and cannot miss. -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}" Margin="20,12,20,0"
                          IsVisible="{Binding IsTargetsOpen}">
                <ItemsControl.Template>
                    <ControlTemplate>
                        <ScrollViewer>
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:TargetRow">
                        <Grid ColumnDefinitions="*,Auto">
                            <Button Classes="row" Click="OnTargetClicked">
                                <Grid ColumnDefinitions="3,*" Margin="0,12">
                                    <Border Background="{StaticResource BrassBrush}"
                                            IsVisible="{Binding IsChosen}" />
                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" Spacing="3">
                                        <TextBlock Text="{Binding Name}" Classes="inscription"
                                                   FontSize="15" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Classes="caption" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                            <Button Grid.Column="1" Content="{Binding DismissLabel}" FontSize="10"
                                    Classes="quiet" Padding="12,8" Margin="8,0,0,0"
                                    Click="OnDismissClicked" VerticalAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- The filter. Kinds first because one switch answers what a hundred taps otherwise
                 would, then the map's own list for the finished hearts the API cannot report. -->
            <ScrollViewer Grid.Row="1" Margin="20,12,20,0" IsVisible="{Binding IsFilterOpen}">
                <StackPanel Spacing="10" Margin="0,0,0,20">
                    <TextBlock Text="KINDS" Classes="heading" />

                    <ItemsControl ItemsSource="{Binding KindRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:KindRow">
                                <Grid Margin="0,10" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3">
                                        <TextBlock Text="{Binding Label}" Classes="inscription" FontSize="15" />
                                        <TextBlock Text="{Binding Detail}" Classes="caption" />
                                    </StackPanel>
                                    <!-- A button rather than a switch, and not for looks: a switch
                                         echoes its old value while it is laid out, and in MAUI that
                                         echo undid the stored choice every time the sheet opened.
                                         A click fires for a tap and nothing else. -->
                                    <Button Grid.Column="1" Content="{Binding StateLabel}" FontSize="10"
                                            Classes="quiet" Padding="12,8" Click="OnKindClicked"
                                            VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Classes="rule" />

                    <TextBlock Text="{Binding FilterLine}" Classes="caption" />

                    <Button Content="SHOW EVERYTHING HIDDEN BY HAND" Command="{Binding RestoreHiddenCommand}"
                            Classes="quiet" HorizontalAlignment="Left" />

                    <TextBlock Text="ON THIS MAP" Classes="heading" Margin="0,6,0,0" />

                    <!-- Everything, hidden ones included. A target taken off the dial has to stay
                         somewhere reachable or there is no way back to it. -->
                    <ItemsControl ItemsSource="{Binding AllRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TargetRow">
                                <Grid Margin="0,10" ColumnDefinitions="*,Auto">
                                    <StackPanel Spacing="3" Opacity="{Binding Fade}">
                                        <TextBlock Text="{Binding Name}" Classes="inscription" FontSize="15"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Detail}" Classes="caption" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="{Binding DismissLabel}" FontSize="10"
                                            Classes="quiet" Padding="12,8" Margin="8,0,0,0"
                                            Click="OnDismissClicked" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</shell:PageView>
