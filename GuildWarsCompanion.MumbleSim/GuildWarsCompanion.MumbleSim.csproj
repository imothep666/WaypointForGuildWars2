<Project Sdk="Microsoft.NET.Sdk">

    <!--
        A development tool, not part of the product.

        The compass screen cannot be built or demonstrated without a character moving around a
        map, and Guild Wars 2 is not always running on the machine the app is being written on.
        This writes the same shared memory block the game writes, so the bridge reads a walking
        character and the phone draws one.

        Windows only by nature: MumbleLink is a named Windows memory mapping. On Linux the
        equivalent is writing the file jokolink would have written, which is left undone until
        something needs it.
    -->

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>GuildWarsCompanion.MumbleSim</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- The real offsets, not a second copy of them. A simulator that agreed with its own
             idea of the layout would prove nothing about the reader. -->
        <Compile Include="..\GuildWarsCompanion.Bridge\Protocol\MumbleLink.cs" Link="MumbleLink.cs" />
        <Compile Include="..\GuildWarsCompanion.Bridge\Protocol\GameState.cs" Link="GameState.cs" />
    </ItemGroup>

</Project>
